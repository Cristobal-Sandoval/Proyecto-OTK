# ==========================================
# CONFIGURACIÓN DE CLOUDINARY PARA OTAKONCE
# ==========================================
# 1. Regístrate gratis en https://cloudinary.com
# 2. Ve a Settings (engranaje) -> Upload -> Upload Presets
# 3. Haz clic en "Add upload preset"
# 4. Configura "Signing Mode" como "Unsigned"
# 5. Guarda y copia el nombre del Preset y tu Cloud Name aquí abajo:

VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name_aqui
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset_unsigned_aqui
VITE_CLOUDINARY_FOLDER=otakonce

# ==========================================
# BACKEND ADMIN (server-only, SIN prefijo VITE_ => nunca van al bundle)
# Opción A (recomendada): hash scrypt. Genera con: npm run gen:hash -- "tu-clave-larga"
# Opción B (entornos de prueba): clave directa, sin generar nada.
# Basta con definir UNA de las dos variables de clave.
# ==========================================
ADMIN_PASSWORD_HASH=scrypt$TU_SALT_HEX$TU_HASH_HEX
# ADMIN_PASSWORD=tu-clave-directa-solo-para-pruebas
ADMIN_SESSION_SECRET=genera_un_secreto_aleatorio_largo_de_32_chars_minimo

# ==========================================
# SUPABASE (datos: tema, postulaciones, galería publicada)
# 1. Crea el proyecto en https://supabase.com y corre supabase/schema.sql
# 2. Copia Project URL + service_role key (Settings > API).
# Sin estas vars el backend usa memoria efímera (se pierde con redeploys).
# ==========================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# VITE_ADMIN_HASH quedó obsoleto (auth ahora es server-side con scrypt).
# Si existe en tu .env.local, elimínalo tras migrar a ADMIN_PASSWORD_HASH.
